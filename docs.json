{
  "theme": "mint",
  "name": "COD King Documentation",
  "description": "Official documentation for COD King — configure and manage Cash on Delivery workflows for your Shopify store.",

  "colors": {
    "primary": "#196bf5",
    "light": "#4C8DF7",
    "dark": "#0B4FC2"
  },

  "logo": {
    "light": "/images/withbglogo2.png",
    "dark": "/images/withbglogo2.png"
  },

  "favicon": "/logo/CK logo icon-1200px.png",

  "appearance": {
    "default": "light",
    "strict": true
  },

  "navbar": {
    "links": [
      {
        "href": "mailto:support@notifiktech.com",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://codking.tech/"
    }
  },

  "seo": {
    "metatags": {
      "og:title": "COD King Documentation",
      "og:description": "Official guides and documentation for COD King on Shopify.",
      "og:site_name": "Codking Docs"
    }
  },

  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "href": "#"
      },
      {
        "tab": "Dashboard Handbook",
        "href": "partial-payment/overview"
      },
      {
        "tab": "API Reference",
        "href": "integrations/overview"
      },
      {
        "tab": "Changelog",
        "href": "support/faq"
      }
    ]
  },
  "background": {
    "decoration": "gradient"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "search": {
    "prompt": "Search Codking docs..."
  }
}
